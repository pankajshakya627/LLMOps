  "cards": [
    {
      "dot": "amber",
      "title": "Proposed, not running",
      "items": [
        "Local Compose still uses Ollama/OpenAI and self-hosted Phoenix; this AWS target is not deployed.",
        "Claude chat and Titan V2 embeddings need new LiteLLM routes, model access and a re-embedded corpus.",
        "Bedrock Guardrails need new fail-closed input/output calls in the application."
      ]
    },
    {
      "dot": "cyan",
      "title": "Arize AX enterprise SaaS",
      "items": [
        "No Phoenix container or trace database in AWS. API and gateway export masked OTLP over approved outbound TLS.",
        "Use the enterprise space ID, API key, tenant endpoint and separate API/gateway project names.",
        "Migrate API tracing to arize-otel, LiteLLM to the arize callback, and Ragas export to Arize span evaluations."
      ]
    },
    {
      "dot": "emerald",
      "title": "AWS service split",
      "items": [
        "ECS Fargate runs UI, API, LiteLLM and one-off ingestion; RDS pgvector stores policy evidence and feedback.",
        "Bedrock runs Claude and Titan V2; versioned S3 supplies the corpus and receives evaluation reports.",
        "Use scoped IAM, Secrets Manager and an approved Bedrock Runtime VPC endpoint."
      ]
    },
    {
      "dot": "slate",
