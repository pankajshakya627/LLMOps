# Docker stack: docker compose --env-file .env -f app/compose.yaml up -d
# Model endpoints/index profiles and other defaults live in app/compose.yaml and app/gateway/.

# Local PostgreSQL / pgvector (no Atlas account required)
STORAGE_BACKEND=pgvector
POSTGRES_PASSWORD=
POSTGRES_DSN=postgresql://nexaassist:${POSTGRES_PASSWORD}@127.0.0.1:5433/nexaassist
# Existing collection setting names identify PostgreSQL corpus namespaces too.
MONGODB_COLLECTION=policy_chunks_qwen3_gateway_v1
# Optional Atlas deployment: STORAGE_BACKEND=mongodb and set MONGODB_URI / MONGODB_DB.

# Policy access scope
INSTITUTION=NexaBank
JURISDICTION=IN
CONFIDENTIALITY_LEVEL=internal

# OpenAI gateway route and independent Ragas judge
OPENAI_API_KEY=
OPENAI_LITELLM_CHAT_MODEL=openai/gpt-6-luna
EVAL_JUDGE_MODEL=gpt-6.1-sol

# Gateway authentication
LITELLM_MASTER_KEY=

# Existing deployment and host ports
COMPOSE_PROJECT_NAME=nexaassist
API_PORT=8001
GATEWAY_PORT=4001

# Synthetic trace content only; disable for private data
PHOENIX_CAPTURE_CONTENT=false

# Feedback review; leave empty to keep review/export disabled
FEEDBACK_REVIEWER_TOKEN=
