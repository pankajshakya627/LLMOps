# Overlay on private .env. Set CHAT_API_KEY and EMBEDDING_API_KEY to the gateway key there.
CHAT_MODEL=nexa-chat
CHAT_BASE_URL=http://127.0.0.1:4000/v1
CHAT_API_MODE=chat_completions
CHAT_REASONING_EFFORT=
CHAT_CACHE_NAMESPACE=nexaassist-private
# LiteLLM owns provider-error fallback; do not stack a second cloud fallback.
OPENAI_FALLBACK_MODEL=
EMBEDDING_BASE_URL=http://127.0.0.1:4000/v1
EMBEDDING_MODEL=nexa-embed-local
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROFILE=qwen3-0.6b-gateway-v1
MONGODB_COLLECTION=policy_chunks_qwen3_gateway_v1
MONGODB_PARENT_COLLECTION=policy_sections_qwen3_gateway_v1
VECTOR_INDEX_NAME=policy_qwen3_gateway_v1
GUARDRAILS_BASE_URL=http://127.0.0.1:8101
PHOENIX_BASE_URL=http://127.0.0.1:6006
