# Chat-only overlay on the direct Ollama profile; existing retrieval stores stay unchanged.
# Supply CHAT_API_KEY from the private LITELLM_MASTER_KEY in the launching environment.
CHAT_MODEL=nexa-chat
CHAT_BASE_URL=http://127.0.0.1:4000/v1
CHAT_API_MODE=chat_completions
CHAT_REASONING_EFFORT=
CHAT_CACHE_NAMESPACE=nexaassist-private
OPENAI_FALLBACK_MODEL=
