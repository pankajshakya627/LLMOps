# Overlay on .env. These are example NEW store names; do not point at OpenAI stores.
CHAT_MODEL=qwen3.5:9b-mlx
CHAT_BASE_URL=http://127.0.0.1:11434/v1
CHAT_API_KEY=ollama
CHAT_API_MODE=chat_completions
# Avoid exhausting the bounded output budget on thinking before structured JSON.
CHAT_REASONING_EFFORT=none
CHAT_CACHE_NAMESPACE=
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
# Example expected length: verify the actual local runtime before creating the index.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROFILE=qwen3-0.6b-local-v1
MONGODB_COLLECTION=policy_chunks_qwen3_v1
MONGODB_PARENT_COLLECTION=policy_sections_qwen3_v1
VECTOR_INDEX_NAME=policy_qwen3_v1
# Evaluator model/endpoint/key and metric embeddings retain their independent settings.
