# Overlay on application.env.example; embeddings are a separate corpus, never a fallback.
EMBEDDING_MODEL=nexa-embed-openai
EMBEDDING_DIMENSIONS=1536
EMBEDDING_PROFILE=openai-3-small-gateway-v1
MONGODB_COLLECTION=policy_chunks_openai_gateway_v1
MONGODB_PARENT_COLLECTION=policy_sections_openai_gateway_v1
VECTOR_INDEX_NAME=policy_openai_gateway_v1
# Matching Compose interpolation values; native Settings ignores this prefix.
GATEWAY_EMBEDDING_MODEL=nexa-embed-openai
GATEWAY_EMBEDDING_DIMENSIONS=1536
GATEWAY_EMBEDDING_PROFILE=openai-3-small-gateway-v1
GATEWAY_MONGODB_COLLECTION=policy_chunks_openai_gateway_v1
GATEWAY_MONGODB_PARENT_COLLECTION=policy_sections_openai_gateway_v1
GATEWAY_VECTOR_INDEX_NAME=policy_openai_gateway_v1
