# For a native gateway; Compose supplies its own container-reachable URLs.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
LITELLM_LOCAL_MODEL_COST_MAP=True

# Gateway model/deployment evidence; raw messages remain excluded.
LITELLM_OTEL_V2=true
PHOENIX_COLLECTOR_HTTP_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=nexaassist-gateway
OTEL_SERVICE_NAME=nexaassist-gateway
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=no_content
