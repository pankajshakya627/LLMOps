    {
      "name": "current_processing_fee",
      "attempt": 1,
      "path": "/answer",
      "status": 200,
      "duration_ms": 6214.38,
      "body": {
        "as_of": "2026-10-01",
        "status": "answered",
        "answer": "For loans sanctioned on or after 2026-07-01, the processing fee is 0.30% of the sanctioned loan amount, subject to a minimum of ₹5,000 and a maximum of ₹10,000, plus GST at 18% [1][2]. Loans sanctioned before 2026-07-01 keep the processing fee that applied at sanction [1].",
        "citations": [
          {
            "evidence_id": 1,
            "quote": "Processing fee is 0.30% of the sanctioned loan amount, subject to a minimum of ₹5,000 and a maximum of ₹10,000, plus GST.",
            "matched_child": {
              "doc_id": "CIR-2026-07",
              "title": "Circular CIR-2026-07",
              "policy_version": "1.0",
              "clause": null,
              "effective_date": "2026-07-01"
            }
          },
          {
            "evidence_id": 2,
            "quote": "All fees are exclusive of GST at 18%, which is charged additionally.",
            "matched_child": {
              "doc_id": "POL-HL-V3",
              "title": "NexaHome Loan Policy",
              "policy_version": "3.0",
              "clause": "6.2",
              "effective_date": "2025-10-01"
            }
          },
          {
            "evidence_id": 1,
            "quote": "Loans sanctioned before that date keep the processing fee that applied at sanction, and no refund or adjustment is made.",
