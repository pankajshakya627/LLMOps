    "input": {
      "query": "What is the current processing fee for a NexaHome Loan?",
      "as_of": "2026-10-01",
      "product_id": "NEXA-HL",
      "top_k": 20
    },
    "reference": "For loans sanctioned on or after 1 July 2026 the processing fee is 0.30% of the sanctioned amount, minimum ₹5,000 and maximum ₹10,000, plus 18% GST. This comes from circular CIR-2026-07, which replaced clause 6.2 of POL-HL-V3. Loans sanctioned earlier keep the fee that applied at their sanction.",
